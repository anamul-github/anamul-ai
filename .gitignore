# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets (API keys) never go to GitHub
.env

# Mac and editor files
.DS_Store
.Rhistory

# Built by chunk.py; rebuild it any time with: uv run python -m anamul_ai.chunk
data/chunks.jsonl

# Built by embed.py; rebuild it with: uv run python -m anamul_ai.embed
# data/embeddings.json is committed: GitHub's deploy needs it and can't rebuild it without my Voyage key

# Every answer from the last eval run; rebuild it with: uv run python -m anamul_ai.evals
evals/last_run.json

# Terraform: downloaded providers, and state (it holds a copy of the Lambda's settings, including my API keys)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
# My alert email and any other private Terraform settings
infra/*.tfvars
